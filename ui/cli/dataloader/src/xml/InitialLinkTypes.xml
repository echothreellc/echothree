            <linkTypeTranslation languageIsoName="en" description="Has Part" guidanceMimeTypeName="text/plain"
                                 guidance="The source item contains the target item as a constituent, directly or indirectly. This is the inverse of Part Of." />
        </linkType>
        <linkType linkTypeName="DIRECT_PART_OF" parentLinkTypeName="PART_OF" sourceComponentVendorName="ECHO_THREE" sourceEntityTypeName="Item"
