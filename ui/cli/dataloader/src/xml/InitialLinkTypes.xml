                  linkCardinalityName="MANY_TO_MANY" linkDirectionalityName="DIRECTED" isTransitive="true" sortOrder="1">
            <linkTypeTranslation languageIsoName="en" description="Part Of" guidanceMimeTypeName="text/plain"
                                 guidance="The source item is a constituent of the target item, directly or through a chain of part relationships. This does not express ownership, substitution, or compatibility." />
        </linkType>
        <linkType linkTypeName="HAS_PART" sourceComponentVendorName="ECHO_THREE" sourceEntityTypeName="Item"
