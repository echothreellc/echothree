                  linkCardinalityName="MANY_TO_ONE" linkDirectionalityName="DIRECTED" isTransitive="false" sortOrder="3">
            <linkTypeTranslation languageIsoName="en" description="Direct Part Of" guidanceMimeTypeName="text/plain"
                                 guidance="The source item is an immediate constituent of the target item. Each source item has at most one immediate parent. Do not use this relationship for ancestors." />
        </linkType>
        <linkType linkTypeName="DIRECT_HAS_PART" parentLinkTypeName="HAS_PART" sourceComponentVendorName="ECHO_THREE" sourceEntityTypeName="Item"
