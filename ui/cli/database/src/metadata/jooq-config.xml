<configuration xmlns="http://www.jooq.org/xsd/jooq-codegen-3.21.1.xsd">
    <!-- Keep generation output focused on actionable problems. -->
    <logging>WARN</logging>

    <!-- Configure the database connection here -->
    <generator>
        <name>com.echothree.ui.cli.database.util.jooqgen.JooqJavaGenerator</name>
        <!-- A programmatic naming strategy implementation, referenced by class name. -->
        <strategy>
            <name>com.echothree.ui.cli.database.util.jooqgen.JooqGeneratorStrategy</name>
        </strategy>

        <database>
            <name>org.jooq.meta.xml.XMLDatabase</name>

            <!-- Read metadata only from the model's schema. This is an input
                 filter used during generation, not a runtime SQL qualifier. -->
            <inputSchema>echothree</inputSchema>

            <!-- Generate schema-less and catalog-less table metadata. At
                 runtime, each tenant's datasource selects its database. -->
            <outputCatalogToDefault>true</outputCatalogToDefault>
            <outputSchemaToDefault>true</outputSchemaToDefault>
            <properties>
                <!-- Use any of the SQLDialect values here -->
                <property>
                    <key>dialect</key>
                    <value>MYSQL</value>
                </property>

                <!-- Specify the location of your database file -->
                <property>
                    <key>xmlFile</key>
                    <value>../../../generated/data/xml/XMLDatabase.xml</value>
                </property>
            </properties>
        </database>

        <!-- Generation flags: See advanced configuration properties -->
        <generate>
            <!-- The default output catalog and schema are unnamed, so their
                 otherwise-empty Java reference classes are unnecessary. -->
            <defaultCatalog>false</defaultCatalog>
            <defaultSchema>false</defaultSchema>

            <!-- Inbound paths collide with outbound MySQL foreign-key names for
                 self-references and tables having two keys to the same target. -->
            <implicitJoinPathsToMany>false</implicitJoinPathsToMany>
        </generate>

        <target>
            <!-- The destination package of your generated classes (within the
                 destination directory)

                 jOOQ may append the schema name to this package if generating multiple schemas,
                 e.g. org.jooq.your.packagename.schema1
                      org.jooq.your.packagename.schema2 -->
            <packageName>com.echothree.model.jooq.server</packageName>

            <!-- The destination directory of your generated classes -->
            <directory>../../../generated/data/java</directory>
        </target>
    </generator>
</configuration>
